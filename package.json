{
  "name": "low-pass",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianba/low-pass.git"
  },
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/copy-notices.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:formation-preview": "node scripts/build-formation-preview.mjs",
    "build:combat-preview": "node scripts/build-combat-preview.mjs",
    "build:connectivity-preview": "node scripts/build-connectivity-preview.mjs",
    "build:room-controls": "node scripts/build-room-controls.mjs",
    "start:server": "node dist-server/server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:server": "vitest run tests/server",
    "test:container": "node --test --test-concurrency=1 --test-timeout=90000 tests/container/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint src server shared tests",
    "assets:verify": "node scripts/verify-assets.mjs",
    "assets:aircraft": "uv run --no-project --python /usr/bin/python3 --with numpy python scripts/export-aircraft.py"
  },
  "dependencies": {
    "@babylonjs/core": "9.25.0",
    "@babylonjs/loaders": "9.25.0",
    "compression": "1.8.2",
    "express": "5.2.1",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
